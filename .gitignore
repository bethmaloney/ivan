# Do not track these files.

# CMake build trees
build/
build-*/

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]
__pycache__

# Log files
log/
*.log

# ...except the golden text logs, which are committed test data rather than
# output. They keep the .log suffix so they match the artifact they are compared
# against, which run-corpus.sh writes as text.log.
!tools/corpora/*.text.log

# Package files
*.jar
/*egg-info/

# Maven
target/

# JetBrains IDE
.idea/
venv/

# Visual Studio
.vs*

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Temporary files
~$*.doc*
~$*.xls*
~$*.ppt*
