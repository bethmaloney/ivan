# Do not track these files.

# CMake build trees
build/
build-*/

# Node artifact files
node_modules/
dist/

# wrangler's local state, written beside the project it deploys
.wrangler/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]
__pycache__

# Log files
log/
*.log

# ...except the golden text logs, which are committed test data rather than
# output. They keep the .log suffix so they match the artifact they are compared
# against, which run-corpus.sh writes as text.log.
!tools/corpora/*.text.log

# Package files
*.jar
/*egg-info/

# Maven
target/

# JetBrains IDE
.idea/
venv/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Temporary files
~$*.doc*
~$*.xls*
~$*.ppt*

# What a run leaves in the working tree. PORTABLE_BUILD makes both
# game::GetDataDir() and GetUserDataDir() return "./" (game.cpp:5416,
# save.cpp:845), so a game played -- or a recording replayed -- from the repo
# root writes its saves, screenshots and prompt history here. Replaying a
# recording is a documented debugging step (tools/web/README.md), so this is
# ordinary traffic rather than an accident. Save/readme.txt is tracked and
# stays that way.
Save/*
!Save/readme.txt
Scrshot/*
!Scrshot/.gitkeep
.QuestionHistory_*.txt
ivan.cfg
